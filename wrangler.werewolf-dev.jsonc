{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meolord-werewolf-local",
  "main": "worker.werewolf-dev.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "WEREWOLF_ROOMS", "class_name": "WerewolfRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WerewolfRoom"] }
  ]
}
